APP_NAME=BhuNirnay API
# Comma-separated local and production frontend URLs. Do not add a trailing slash.
FRONTEND_ORIGINS=http://localhost:5173,https://your-vercel-project.vercel.app
# Leave this enabled for Vercel preview URLs, or set blank to allow only the URLs above.
FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace_with_backend_only_secret
GEMINI_API_KEY=replace_with_gemini_api_key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
GENERATION_MODEL=gemini-3.7-flash
RAG_CHUNK_TARGET_CHARS=3200
RAG_EMBED_BATCH_SIZE=1
RAG_EMBED_DELAY_SECONDS=4
