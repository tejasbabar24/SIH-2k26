APP_NAME=BhuNirnay API
# Comma-separated local and production frontend URLs. Do not add a trailing slash.
FRONTEND_ORIGINS=http://localhost:5173,https://sih-2k26-alpha.vercel.app
# Keep blank in production unless temporary Vercel preview support is required.
FRONTEND_ORIGIN_REGEX=
